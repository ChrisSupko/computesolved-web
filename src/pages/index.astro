---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<p class="eyebrow">Practical technology. Reliable results.</p>
				<p class="intro">
					{SITE_DESCRIPTION} We help turn technical challenges into clear,
					reliable solutions.
				</p>
				<div class="actions">
					<a class="button primary" href="/about">Learn more about us</a>
					<a class="button secondary" href="/blog">Explore our projects</a>
				</div>
			</section>

			<section class="services" aria-labelledby="services-title">
				<h2 id="services-title">How we can help</h2>
				<div class="service-grid">
					<article>
						<h3>Understand</h3>
						<p>We work with you to find the best solution at any price point.</p>
					</article>
					<article>
						<h3>Scale</h3>
						<p>Design a hybrid solution to support your busness as you grow.</p>
					</article>
					<article>
						<h3>Solve</h3>
						<p>We help immplement on prem or cloud solutions to fit any busness needs.</p>
					</article>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 3rem 0 4rem;
		text-align: center;
	}

	.eyebrow {
		margin-bottom: 1rem;
		color: var(--accent-dark);
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 850px;
		margin: 0 auto 1rem;
	}

	.intro {
		max-width: 650px;
		margin: 0 auto 2rem;
		font-size: 1.15em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.button {
		display: inline-block;
		padding: 0.7rem 1.2rem;
		border: 2px solid var(--accent);
		border-radius: 0.35rem;
		font-weight: 700;
		text-decoration: none;
	}

	.button.primary {
		background: var(--accent);
		color: white;
	}

	.button.primary:hover {
		background: var(--accent-dark);
		color: white;
	}

	.button.secondary {
		background: transparent;
		color: var(--accent);
	}

	.services {
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
		text-align: center;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
		text-align: left;
	}

	.service-grid article {
		padding: 1.5rem;
		border-radius: 0.5rem;
		background: rgb(var(--gray-light));
	}

	.service-grid h3 {
		font-size: 1.4em;
	}

	.service-grid p {
		margin-bottom: 0;
	}

	@media (max-width: 720px) {
		.hero {
			padding: 1rem 0 3rem;
		}

		.hero h1 {
			font-size: 2.2em;
		}

		.service-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
